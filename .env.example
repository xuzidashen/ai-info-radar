APP_ENV=cloud
APP_BASE_URL=https://aileida.zh.kg
NEXT_PUBLIC_MOBILE_BASE_URL=https://aileida.zh.kg

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

SEARCH_PROVIDER=mock
SUMMARY_PROVIDER=mock
FACTOR_PROVIDER=mock
LINKAGE_PROVIDER=mock

TAVILY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

CRON_SECRET=
INTERNAL_API_SECRET=
APP_ADMIN_TOKEN=

ENABLE_PUBLIC_ACCESS=false
ENABLE_SETUP_WIZARD=false
DEFAULT_TIMEZONE=Asia/Shanghai

# Optional legacy/documentation flag used by health checks only.
# Prisma schema does not read this value.
# DATABASE_PROVIDER=postgres
